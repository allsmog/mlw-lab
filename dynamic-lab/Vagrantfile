# Detonation VM for Stuxnet dynamic analysis.
#
# - Windows 7 SP1 x86 (Stuxnet is 32-bit and targets older Windows).
# - HOST-ONLY network only. No NAT. No bridged. No port forwarding.
# - Snapshot before every run; restore between runs.
# - Provisioning installs analyst tools but does NOT pull samples — you copy
#   those in manually after taking a clean snapshot.
#
# REQUIRES: a Windows 7 base box you have rights to. Microsoft no longer ships
# free dev VMs of Win7. Common options:
#   - Build your own from an ISO + license you own (school often has MSDN AA).
#   - Use a VirtualBox appliance you've imported and converted (`vagrant package`).
# Update WIN7_BOX below to your local box name.

WIN7_BOX = ENV.fetch("WIN7_BOX", "win7-sp1-x86-analyst")  # override with your box

Vagrant.configure("2") do |config|
  config.vm.box = WIN7_BOX
  config.vm.communicator = "winrm"
  config.vm.guest = :windows
  config.winrm.username = "analyst"
  config.winrm.password = "analyst"
  config.vm.boot_timeout = 600

  # HARD REQUIREMENT: host-only network, no other interfaces.
  # The IP below sits on a private subnet that does not route to the internet.
  config.vm.network "private_network", ip: "192.168.56.10",
                                        virtualbox__intnet: false,
                                        auto_config: true
  # Do NOT add `config.vm.network "forwarded_port"` or `public_network`.

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "stuxnet-detonation"
    vb.gui    = true
    vb.memory = 2048
    vb.cpus   = 2
    # Disable clipboard / drag-drop / shared folders to reduce host exposure.
    vb.customize ["modifyvm", :id, "--clipboard-mode", "disabled"]
    vb.customize ["modifyvm", :id, "--draganddrop",   "disabled"]
    vb.customize ["modifyvm", :id, "--audio",         "none"]
    vb.customize ["modifyvm", :id, "--usb",           "off"]
    vb.customize ["modifyvm", :id, "--usbehci",       "off"]
    vb.customize ["modifyvm", :id, "--nictype1",      "82540EM"]
    # Belt-and-suspenders: no second NIC.
    vb.customize ["modifyvm", :id, "--nic2",          "none"]
    vb.customize ["modifyvm", :id, "--nic3",          "none"]
    vb.customize ["modifyvm", :id, "--nic4",          "none"]
  end

  # Disable the default Vagrant shared folder. We do NOT want bidirectional
  # filesystem access between host and a VM that will run live malware.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Provision analyst tools (NOT samples). Network must be reachable for this
  # one-time bootstrap; do it BEFORE you ever copy a sample in. Take a clean
  # snapshot after this completes.
  config.vm.provision "shell", inline: <<-PS, privileged: true
    Set-ExecutionPolicy Bypass -Scope Process -Force
    [System.Net.ServicePointManager]::SecurityProtocol =
      [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
    iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
    choco install -y --no-progress `
      sysinternals `
      wireshark `
      x64dbg.portable `
      processhacker `
      7zip `
      notepadplusplus `
      windbg
    # FakeNet-NG for fake-internet, FLOSS for offline string deobf.
    choco install -y --no-progress python3
    refreshenv
    py -m pip install --no-warn-script-location flare-fakenet-ng flare-floss
  PS

  # After provisioning, the VM is online for tool install. SHUT DOWN, take a
  # snapshot called "clean-tools-installed", then DISABLE the host's outbound
  # routing for this private_network in your hypervisor before bringing it
  # back up to copy in the sample. See docs/04-network-isolation.md.
end
