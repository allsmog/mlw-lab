# Multi-machine detonation lab for Stuxnet dynamic analysis.
#
#   detonator (192.168.56.10) — where the sample is run
#   target    (192.168.56.11) — peer for SMB / Print Spooler / MS08-067 lateral
#                               movement experiments
#
# Both: Windows 7 SP1 x86, host-only network, snapshot-driven, no shared
# folders / clipboard / USB. Provisioning installs analyst tools but does NOT
# pull samples. Bring up, shut down, snapshot "clean-tools-installed", then
# disable host-level routing to the host-only subnet (see
# docs/04-network-isolation.md) before copying samples in.
#
# REQUIRES a Windows 7 base box you have rights to. Override with:
#   export WIN7_BOX=win7-sp1-x86-analyst
#
# Bring up only one machine at a time as needed:
#   vagrant up detonator
#   vagrant up target
# Or both: `vagrant up`. Halt with `vagrant halt`.

WIN7_BOX = ENV.fetch("WIN7_BOX", "win7-sp1-x86-analyst")

COMMON_PROVISION = <<-PS
  Set-ExecutionPolicy Bypass -Scope Process -Force
  [System.Net.ServicePointManager]::SecurityProtocol =
    [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
  iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))
  choco install -y --no-progress sysinternals wireshark 7zip notepadplusplus
PS

DETONATOR_PROVISION = COMMON_PROVISION + <<-PS
  choco install -y --no-progress x64dbg.portable processhacker windbg python3
  refreshenv
  py -m pip install --no-warn-script-location flare-fakenet-ng flare-floss
PS

TARGET_PROVISION = COMMON_PROVISION + <<-PS
  # Set up the target as a juicy lateral-movement victim.
  Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled False
  # Enable file & printer sharing so SMB and Print Spooler are reachable.
  Set-Service -Name LanmanServer  -StartupType Automatic
  Set-Service -Name LanmanWorkstation -StartupType Automatic
  Set-Service -Name Spooler       -StartupType Automatic
  Start-Service LanmanServer, LanmanWorkstation, Spooler
  # Create a writable share for credential/share-write propagation.
  New-Item -Path C:\\Share -ItemType Directory -Force | Out-Null
  New-SmbShare -Name "Share" -Path C:\\Share -FullAccess Everyone -ErrorAction SilentlyContinue
  # Add a fake printer so the spooler exposes its RPC interface.
  Add-PrinterPort -Name "FakePort" -PrinterHostAddress "127.0.0.1" -ErrorAction SilentlyContinue
  Add-Printer -Name "FakePrinter" -DriverName "Microsoft XPS Document Writer" -PortName "FakePort" -ErrorAction SilentlyContinue
  Set-Printer -Name "FakePrinter" -Shared $true -ShareName "FakePrinter" -ErrorAction SilentlyContinue
  # Disable Defender so it doesn't yank the dropped file before you can see it.
  Set-MpPreference -DisableRealtimeMonitoring $true -ErrorAction SilentlyContinue
PS

def configure_common(vm_config, name, ip)
  vm_config.vm.box = WIN7_BOX
  vm_config.vm.communicator = "winrm"
  vm_config.vm.guest = :windows
  vm_config.winrm.username = "analyst"
  vm_config.winrm.password = "analyst"
  vm_config.vm.boot_timeout = 600
  vm_config.vm.hostname = name
  vm_config.vm.network "private_network", ip: ip,
                                          virtualbox__intnet: false,
                                          auto_config: true
  vm_config.vm.synced_folder ".", "/vagrant", disabled: true

  vm_config.vm.provider "virtualbox" do |vb|
    vb.name   = "stuxnet-#{name}"
    vb.gui    = true
    vb.memory = 2048
    vb.cpus   = 2
    vb.customize ["modifyvm", :id, "--clipboard-mode", "disabled"]
    vb.customize ["modifyvm", :id, "--draganddrop",   "disabled"]
    vb.customize ["modifyvm", :id, "--audio",         "none"]
    vb.customize ["modifyvm", :id, "--usb",           "off"]
    vb.customize ["modifyvm", :id, "--usbehci",       "off"]
    vb.customize ["modifyvm", :id, "--nictype1",      "82540EM"]
    vb.customize ["modifyvm", :id, "--nic2",          "none"]
    vb.customize ["modifyvm", :id, "--nic3",          "none"]
    vb.customize ["modifyvm", :id, "--nic4",          "none"]
  end
end

Vagrant.configure("2") do |config|
  config.vm.define "detonator", primary: true do |dt|
    configure_common(dt, "detonator", "192.168.56.10")
    dt.vm.provision "shell", inline: DETONATOR_PROVISION, privileged: true
  end

  config.vm.define "target", autostart: false do |tg|
    configure_common(tg, "target", "192.168.56.11")
    tg.vm.provision "shell", inline: TARGET_PROVISION, privileged: true
  end
end
