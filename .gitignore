# Never commit malware samples or extracted artifacts.
samples/**
!samples/.gitkeep
!samples/README.md

# Analysis output may contain quoted bytes / decoded strings — keep local.
analysis/**/output/
analysis/**/dumps/
analysis/**/*.bin
analysis/**/*.exe
analysis/**/*.dll
analysis/**/*.sys
analysis/**/*.lnk
analysis/**/*.dmp
analysis/**/*.vmdk
analysis/**/*.vdi

# VM artifacts.
.vagrant/
*.box

# Instructor approval — keep local proof of authorization, don't publish.
docs/instructor-approval.txt

# Tooling caches.
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
*.swp
.DS_Store

# Ghidra projects (large, regenerable).
*.gpr
*.rep/
